---
import "@styles/global.css";
import Navbar from '@components/reusable/layout/Navbar.astro';
import Footer from '@components/reusable/layout/Footer.astro';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = "Unity Provisions",
  description = "Creating opportunities and building stronger communities."
} = Astro.props as Props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <meta name="description" content={description} />

    <meta name="generator" content={Astro.generator} />

    <title>{title}</title>

    <link rel="icon" href="/unity-provisions.svg" />
  </head>

  <body class="min-h-screen">
    <Navbar />

    <main>
      <slot />
    </main>

    <Footer />
  </body>
</html>