---
import "@styles/global.css";
import Navbar from '@components/reusable/layout/Navbar.astro';
import Footer from '@components/reusable/layout/Footer.astro';
import defaultOgImage from '@assets/components/hero.jpg';
import type { ImageMetadata } from 'astro';

interface Props {
  title?: string;
  description?: string;
  image?: ImageMetadata; // Optional page-specific image for social sharing.
}

const {
  title = "Unity Provisions",
  description = "Creating opportunities and building stronger communities.",
  image = defaultOgImage,
} = Astro.props as Props;

// Use an absolute URL so search engines can identify the canonical page.
const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const ogImageURL = new URL(image.src, Astro.site);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalURL} />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Unity Provisions" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImageURL} />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageURL} />

    <meta name="generator" content={Astro.generator} />

    <title>{title}</title>

    <link rel="icon" href="/unity-provisions.svg" />
  </head>

  <body class="min-h-screen">
    <Navbar />

    <main>
      <slot />
    </main>

    <Footer />
  </body>
</html>