---
import Layout from "@layouts/Layout.astro";

import AboutHeading from "@components/page-specific/about/About_Heading.astro";
import AboutBiggestEvent from "@components/page-specific/about/About_BiggestEvent.astro";
import AboutStats from "@components/page-specific/about/About_Stats.astro";
import AboutPartnersAndSupporters from "@components/page-specific/about/About_PartnersAndSupporters.astro";
import AboutAnnualReport from "@components/page-specific/about/About_AnnualReport.astro";
import AboutTeam from "@components/page-specific/about/About_Team.astro";
---

<Layout
  title="About — Unity Provisions"
  description="How Unity Provisions began, and the youth-led network of student leaders it has grown into."
>
  <AboutHeading />

  <!--
    Full-bleed hairline at the founder-story / Biggest Event seam —
    both are white sections stacked directly on each other with no
    color-band boundary between them (§11: divider rule). border-border,
    edge-to-edge like every other border on the site (never scoped to
    content width) — see About_BiggestEvent's own trimmed top padding
    for the other half of this fix.
  -->
  <div class="border-t border-border"></div>

  <AboutBiggestEvent />

  <AboutStats />

  <AboutPartnersAndSupporters />

  <AboutAnnualReport />

  <!--
    Same divider rule (§11) — AboutAnnualReport and AboutTeam are the
    literal same wrapper (icon-badge heading + subtext + single CTA,
    centered), back to back, with no color shift between them.
  -->
  <div class="border-t border-border"></div>

  <AboutTeam />
</Layout>