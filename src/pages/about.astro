---
import Layout from '@layouts/Layout.astro';
import Container from '@components/ui/Container.astro';
import SectionHeading from '@components/ui/SectionHeading.astro';
import ResponsiveImage from '@components/ui/ResponsiveImage.astro';
import ImpactStats from '@components/sections/ImpactStats.astro';
import PartnersAndSupporters from '@components/sections/PartnersAndSupporters.astro';
import ryanPhoto from '@assets/ryan_nguyen.webp';
import { stats } from '@data/stats';
import { partners } from '@data/partners';
---

<Layout
  title="About — Unity Provisions"
  description="How Unity Provisions began, and the youth-led network of student leaders it has grown into."
>
  <Container as="section">
    <div class="flex flex-col gap-6 py-12 md:py-16">
      <SectionHeading as="h1" eyebrow="Our Story" title="Is There Dinner?" />

      <div class="flex flex-col gap-8 md:flex-row md:items-start">
        <div class="mx-auto w-full max-w-[280px] shrink-0 md:mx-0">
          <ResponsiveImage
            src={ryanPhoto}
            alt="Ryan Nguyen, founder and CEO of Unity Provisions"
            width={400}
            height={500}
            radius="md"
            loading="eager"
          />
          <p class="mt-3 text-center text-sm text-text-secondary md:text-left">
            Ryan Nguyen — Founder &amp; CEO
          </p>
        </div>

        <div class="flex max-w-3xl flex-col gap-4 text-lg text-text-secondary">
          <p>
            Unity Provisions began with a simple but painful question: "Is
            there dinner?" Growing up, our founder Ryan knew the silence of
            nights when food was uncertain.
          </p>
          <p>
            Later, while volunteering at a local food pantry, he saw
            firsthand how hunger hides behind quiet sacrifices—a mother
            choosing between diapers and oatmeal, neighbors masking need
            with a smile. When that pantry abruptly shut down in 2024, Ryan
            realized how fragile food programs could be. He founded Unity
            Provisions to build something that couldn't disappear
            overnight.
          </p>
          <p>
            What started with a single branch at Boston Latin School has
            grown into a youth-led network of over 35 branches across
            multiple countries. Together, student leaders have collected
            thousands of pounds of food and clothing, raised thousands of
            dollars, and built partnerships with organizations like the
            Wang YMCA to sustain community-based donation centers — see
            the current numbers below.
          </p>
          <p>
            Our mission is to empower young people to fight hunger by
            creating and leading donation centers in their schools and
            communities.
          </p>
        </div>
      </div>
    </div>
  </Container>

  <Container as="section">
    <div class="flex flex-col items-center gap-2 py-12 text-center md:py-16">
      <SectionHeading
        eyebrow="By The Numbers"
        title="Our Impact"
        subtext="Real numbers, updated live from branches around the world."
        align="center"
      />
    </div>
  </Container>

  <ImpactStats stats={stats} />

  <Container as="section">
    <div class="flex flex-col items-center gap-2 py-12 text-center md:py-16">
      <SectionHeading
        eyebrow="Our Network"
        title="Partners & Supporters"
        subtext="The organizations that help make our work possible."
        align="center"
      />
    </div>
  </Container>

  <PartnersAndSupporters
    partners={partners}
    partnersIntro="These organizations open their doors and share their resources with us, giving Unity Provisions branches the space, logistics, and on-the-ground support to run donation centers in their communities."
    supportersIntro="Grants and funding from these organizations help us stock donation centers, launch new branches, and reach the students and families who need us most."
  />
</Layout>