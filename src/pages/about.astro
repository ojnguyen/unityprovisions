---
import Layout from '@layouts/Layout.astro';
import Container from '@components/reusable/ui/Container.astro';
import SectionHeading from '@components/reusable/ui/SectionHeading.astro';
import ResponsiveImage from '@components/reusable/ui/ResponsiveImage.astro';
import ImpactStats from '@components/reusable/sections/ImpactStats.astro';
import PartnersAndSupporters from '@components/reusable/sections/PartnersAndSupporters.astro';
import ExternalLinkCTA from '@components/reusable/ui/ExternalLinkCTA.astro';
import Button from '@components/reusable/ui/Button.astro';
import { Icon } from 'astro-icon/components';
import ryanPhoto from '@assets/team/ryan-nguyen.webp';
import bigEventPhoto from '@assets/projects-and-events/biggest-event.webp';
import { stats } from '@data/stats';
import { partners } from '@data/partners';
import { getStatValue } from '@utils/stats';

// Pulled from stats.ts rather than hardcoded — see utils/stats.ts.
// Used in the founder-story paragraph below (previously "over 35
// branches across multiple countries").
const branchCount = getStatValue('branches'); // "35+"
const countryCount = getStatValue('countries'); // "8+"
---

<Layout
  title="About — Unity Provisions"
  description="How Unity Provisions began, and the youth-led network of student leaders it has grown into."
>
  <Container as="section">
    <div class="flex flex-col gap-6 py-12 md:py-16">
      <SectionHeading as="h1" eyebrow="Our Story" title="Is There Dinner?" />

      <div class="flex flex-col gap-8 md:flex-row md:items-start">
        <div class="mx-auto w-full max-w-[280px] shrink-0 md:mx-0">
          <ResponsiveImage
            src={ryanPhoto}
            alt="Ryan Nguyen, founder and CEO of Unity Provisions"
            width={400}
            height={500}
            radius="md"
            loading="eager"
          />
          <p class="mt-3 text-center text-sm text-text-secondary md:text-left">
            Ryan Nguyen — Founder &amp; CEO
          </p>
        </div>

        <div class="flex max-w-3xl flex-col gap-4 text-lg text-text-secondary">
          <p>
            Unity Provisions began with a simple but painful question: "Is
            there dinner?" Growing up, our founder Ryan knew the silence of
            nights when food was uncertain.
          </p>
          <p>
            Later, while volunteering at a local food pantry, he saw
            firsthand how hunger hides behind quiet sacrifices—a mother
            choosing between diapers and oatmeal, neighbors masking need
            with a smile. When that pantry abruptly shut down in 2024, Ryan
            realized how fragile food programs could be. He founded Unity
            Provisions to build something that couldn't disappear
            overnight.
          </p>
          <p>
            What started with a single branch at Boston Latin School has
            grown into a youth-led network of {branchCount} branches
            across {countryCount} countries. Together, student leaders
            have collected thousands of pounds of food and clothing,
            raised thousands of dollars, and built partnerships with
            organizations like the Wang YMCA to sustain community-based
            donation centers — see the current numbers below.
          </p>
          <p>
            Our mission is to empower young people to fight hunger by
            creating and leading donation centers in their schools and
            communities.
          </p>
        </div>
      </div>
    </div>
  </Container>

  <!--
    "Our Biggest Event Yet" — a single-event spotlight from the live
    site (project-roadmap.md §10), not represented anywhere in this
    revision until now. Placed right after the founder story — a
    concrete, recent proof point that follows naturally from the
    origin narrative, before the page moves into aggregate numbers.
    Photo/prose layout mirrors the founder story above; no dedicated
    component (§2 process, step 1 — used once, page-specific, same
    reasoning as the founder story itself). No icon badge — this
    section has its own visual anchor (the photo + prose), same §11
    rule that rules a badge out for the founder story above it.

    ✅ Real photo now in place: src/assets/biggest_event.webp. Sized
    600×400 (3:2, matching the landscape ratio the section was built
    for) pending a look at the real crop — same "placeholder
    dimensions until someone eyeballs it" pattern already used for
    ryan_nguyen.webp (§7) and agriscan.webp (§7). loading="lazy"
    (ResponsiveImage's default) since this section sits below the
    fold, unlike the founder photo above it.
  -->
  <Container as="section">
    <div class="flex flex-col gap-6 py-12 md:py-16">
      <SectionHeading eyebrow="Recent Highlight" title="Our Biggest Event Yet" />

      <div class="flex flex-col gap-8 md:flex-row md:items-start">
        <div class="mx-auto w-full max-w-[400px] shrink-0 md:mx-0">
          <ResponsiveImage
            src={bigEventPhoto}
            alt="Photo from the North Quincy branch's December 2024 donation drive for the Quincy Community Action Program"
            width={600}
            height={400}
            radius="md"
          />
          <p class="mt-3 text-center text-sm text-text-secondary md:text-left">
            North Quincy branch, December 2024
          </p>
        </div>

        <div class="flex max-w-2xl flex-col gap-4 text-lg text-text-secondary">
          <p>
            In December 2024, our North Quincy branch collected and
            donated 1,025 pounds of food to the Quincy Community Action
            Program — the single largest donation any Unity Provisions
            branch has made to date.
          </p>
          <p>
            It's a snapshot of what one branch, and one determined group
            of students, can do — and a preview of what's possible as
            more branches like it open around the world.
          </p>
        </div>
      </div>
    </div>
  </Container>

  <Container as="section">
    <div class="flex flex-col items-center gap-2 pt-12 pb-4 text-center md:pt-16 md:pb-6">
      <SectionHeading
        title="The Numbers So Far"
        subtext="Real numbers, updated live from branches around the world."
        align="center"
      />
    </div>
  </Container>

  <ImpactStats stats={stats} />

  <!--
    Names all 8 countries backing the "8+ countries" stat above —
    matches the live site's "Creating Opportunities" section (§10),
    not captured anywhere in this revision until now. A caption, not
    its own heading/section — modest padding, no asymmetric treatment
    (§11's asymmetric-padding rule is for a heading introducing a
    full-bleed band; this is a trailing footnote on the sage band
    above it, not an intro to what follows).
  -->
  <Container as="section">
    <div class="py-6 text-center md:py-8">
      <p class="mx-auto max-w-2xl text-sm text-text-secondary">
        Currently active in the United States, Canada, India, the UAE,
        Puerto Rico, Pakistan, Morocco, and England.
      </p>
    </div>
  </Container>

  <!-- Same asymmetric-padding treatment as "The Numbers So Far" above — see project-roadmap.md §11 for the general rule. -->
  <Container as="section">
    <div class="flex flex-col items-center gap-2 pt-12 pb-4 text-center md:pt-16 md:pb-6">
      <SectionHeading
        title="Who Helps Make This Possible"
        subtext="The businesses, nonprofits, and community groups working alongside us."
        align="center"
      />
    </div>
  </Container>

  <PartnersAndSupporters
    partners={partners}
    partnersIntro="These organizations give our branches space, logistics support, and guidance to keep donation centers running in their communities."
    supportersIntro="Grants and funding from these organizations keep our donation centers stocked and help us open new branches where they're needed most."
  />

  <Container as="section">
    <div class="flex flex-col items-center gap-6 py-12 text-center md:py-16">
      <SectionHeading
        title="Annual Report"
        subtext="A look at where your donations went this year."
        align="center"
      />
      <ExternalLinkCTA
        label="Read Our Annual Report"
        href="https://online.fliphtml5.com/uvjxy/tupw/"
        icon="lucide:book-open"
      />
    </div>
  </Container>

  <Container as="section">
    <div class="flex flex-col items-center gap-6 py-12 text-center md:py-16">
      <span class="flex h-12 w-12 items-center justify-center rounded-full bg-primary/10 text-primary">
        <Icon name="lucide:users" aria-hidden="true" class="h-6 w-6" />
      </span>
      <SectionHeading
        title="Meet the People Behind It"
        subtext="The students leading branches, running events, and keeping this whole thing moving."
        align="center"
      />
      <Button href="/team" variant="primary" size="md">
        Meet the Team
      </Button>
    </div>
  </Container>
</Layout>