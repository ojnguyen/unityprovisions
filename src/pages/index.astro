---
import Layout from '@layouts/Layout.astro';
import Hero from '@components/reusable/sections/Hero.astro';
import ImpactStats from '@components/reusable/sections/ImpactStats.astro';
import MissionStatement from '@components/reusable/sections/MissionStatement.astro';
import YouTubeEmbed from '@components/reusable/sections/YouTubeEmbed.astro';
import PartnersAndSupporters from '@components/reusable/sections/PartnersAndSupporters.astro';
import GetInvolvedTeaser from '@components/reusable/sections/GetInvolvedTeaser.astro';
import ContactForm from '@components/reusable/sections/ContactForm.astro';
import DonateBanner from '@components/reusable/sections/DonateBanner.astro';
import { stats } from '@data/stats';
import { partners } from '@data/partners';
import heroImage from '@assets/components/hero.jpg'
---

<Layout>
  <Hero
    headline="Students Ending Hunger"
    tagline="Unity Provisions"
    subtext="A student-led movement building donation centers in schools and communities around the world."
    ctaLabel="Donate"
    ctaHref="/donate"
    secondaryCtaLabel="Watch Our Story"
    secondaryCtaHref="#watch-our-story"
    backgroundImage={heroImage}
  />

  <ImpactStats stats={stats} />

  <MissionStatement
    heading="Our Mission"
    icon="lucide:heart"
    body="At Unity Provisions, we believe that no one should go hungry in a world of abundance. We empower young people to create and lead food collection programs in their schools and communities. Through education, collaboration, and action, we work to reduce food insecurity, challenge the stigma surrounding hunger, and turn surplus into support for those who need it. Together, we are building a future where access to food is a right, not a privilege."
  />

  <YouTubeEmbed
    videoId="QsL7OpKv2Qg"
    title="Watch Our Story"
  />

  <PartnersAndSupporters partners={partners} />

  <GetInvolvedTeaser
    heading="Get Involved"
    icon="lucide:handshake"
    subtext="Whether you want to start a branch, volunteer your time, or stay connected, there's a place for you at Unity Provisions."
    ctaLabel="Learn More"
  />

  <ContactForm
    heading="Contact Us"
    subtext="Have a question, an idea, or just want to say hello? We'd love to hear from you."
  />

  <DonateBanner
    heading="Support Our Mission"
    subtext="Your support helps us keep donation centers stocked, open new branches, and bring our programs to more communities."
    ctaLabel="Donate Now"
  />
</Layout>