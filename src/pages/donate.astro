---
import Layout from "@layouts/Layout.astro";
import QRCodeDonate from "@components/reusable/donate/QRCodeDonate.astro";
import DocumentEmbed from "@components/reusable/donate/DocumentEmbed.astro";
import WhiteSpace from "@components/reusable/ui/WhiteSpace.astro";

import DonateHeading from "@components/page-specific/donate/Donate_Heading.astro";
---

<Layout
  title="Donate — Unity Provisions"
  description="Support Unity Provisions and see exactly where your gift goes."
>
  <DonateHeading />

  <QRCodeDonate
    heading="Support Unity Provisions"
    subtext="Every contribution helps us support existing donation centers and open new ones. Scan the QR code with your phone or use the link below to donate through our secure Zeffy page. Most donations are tax-deductible, and Zeffy automatically provides a tax receipt."
    ctaLabel="Donate via Zeffy"
  />

  <DocumentEmbed
    heading="Track Our Impact"
    subtext="See our impact as it happens. Donation totals and pounds collected are tracked in real time so anyone can follow the progress of Unity Provisions and its branches."
  />

  <WhiteSpace />
</Layout>
