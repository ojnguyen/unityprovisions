---
import Layout from '@layouts/Layout.astro';
import Container from '@components/reusable/ui/Container.astro';
import SectionHeading from '@components/reusable/ui/SectionHeading.astro';
import QRCodeDonate from '@components/reusable/donate/QRCodeDonate.astro';
import DocumentEmbed from '@components/reusable/donate/DocumentEmbed.astro';
---

<Layout
  title="Donate — Unity Provisions"
  description="Support Unity Provisions and see exactly where your gift goes."
>
  <!--
    Page-level h1, same pattern as Projects/Get Involved (§6: exactly
    one h1 per page) — QRCodeDonate and DocumentEmbed each render their
    own h2 below.
  -->
  <Container as="section">
    <div class="flex flex-col items-center gap-2 py-12 text-center md:py-16">
      <SectionHeading
        as="h1"
        title="Donate"
        subtext="Every gift helps a branch open its doors and keep its shelves stocked — and here's exactly where it goes."
        align="center"
      />
    </div>
  </Container>

  <QRCodeDonate
    heading="Give"
    subtext="Every contribution helps us open new donation centers and keep them stocked. Scan the QR code with your phone, or use the link below — both lead to our secure Zeffy donation page, and most gifts are tax-deductible."
    ctaLabel="Donate via Zeffy"
  />

  <DocumentEmbed
    heading="Track Our Impact"
    subtext="Every donation and pound collected, tracked in real time and open for anyone to see."
  />

  <!--
    Plain white spacer — DocumentEmbed now ends on its own sage embed
    band, and Footer is sage too (project-roadmap.md §11).
  -->
  <div class="py-12 md:py-16"></div>
</Layout>