---
import {
  footerNav,
  externalLinks,
  socialLinks,
  phone,
  orgName,
} from '@data/footer';
import Container from '@components/ui/Container.astro';
import { Icon } from 'astro-icon/components';

const year = new Date().getFullYear();
---
<footer class="border-t border-border bg-surface">
  <Container>
    <div class="flex flex-col gap-8 py-10 md:flex-row md:justify-between">
      <nav aria-label="Footer">
        <ul class="flex flex-col gap-2 md:flex-row md:gap-6">
          {footerNav.map((item) => (
            <li>
              <a href={item.href} class="text-sm text-text-secondary hover:text-primary">
                {item.label}
              </a>
            </li>
          ))}
        </ul>
      </nav>

      <ul class="flex flex-col gap-2 md:flex-row md:gap-6">
        {externalLinks.map((link) => (
          <li>
            <a
              href={link.href}
              target="_blank"
              rel="noopener noreferrer"
              class="text-sm text-text-secondary hover:text-primary"
            >
              {link.label}
            </a>
          </li>
        ))}
      </ul>

      <ul class="flex gap-4">
        {socialLinks.map((social) => (
          <li>
            <a
              href={social.href}
              target="_blank"
              rel="noopener noreferrer"
              aria-label={social.label}
              class="text-text-secondary hover:text-primary"
            >
              {social.icon && <Icon name={social.icon} aria-hidden="true" class="h-5 w-5" />}
            </a>
          </li>
        ))}
      </ul>
    </div>

    <div class="flex flex-col items-center gap-2 border-t border-border py-6 text-sm text-text-secondary md:flex-row md:justify-between">
      <p>&copy; {year} {orgName}</p>
      <a href={phone.href} class="hover:text-primary">{phone.label}</a>
    </div>
  </Container>
</footer>