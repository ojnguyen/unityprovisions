---
import { Icon } from 'astro-icon/components';
import { cn } from '@utils/cn';

interface Props {
  as?: 'h1' | 'h2' | 'h3';
  icon?: string;
  eyebrow?: string;
  title: string;
  subtext?: string;
  align?: 'left' | 'center';
}

const {
    as: HeadingTag = 'h2',
    icon,
    eyebrow,
    title,
    subtext,
    align = 'left'
} = Astro.props as Props;

// Maps each supported heading level to its display size.
const headingSizes: Record<'h1' | 'h2' | 'h3', string> = {
  h1: 'text-3xl',
  h2: 'text-2xl',
  h3: 'text-xl',
};

// Keeps the icon badge and text group aligned consistently.
const alignClasses = align === 'center' ? 'items-center text-center' : 'items-start text-left';

// Separates the optional icon badge from the text group.
const wrapperClasses = cn('flex flex-col gap-6', alignClasses);

// Keeps the eyebrow, title, and subtext in a compact group.
const textGroupClasses = cn('flex flex-col gap-2', alignClasses);

// Applies the shared heading color and the selected heading size.
const headingClasses = cn('font-bold text-text-primary', headingSizes[HeadingTag]);
---

<!-- [SECTION HEADING]
- Renders an optional icon, eyebrow, title, and supporting text as one heading block.
- Alignment and heading level are controlled through component props.
-->
<div class={wrapperClasses}>
  {icon && (
    <span class="flex h-12 w-12 items-center justify-center rounded-full bg-primary/10 text-primary">
      <Icon name={icon} aria-hidden="true" class="h-6 w-6" />
    </span>
  )}
  <div class={textGroupClasses}>
    {eyebrow && (
      <p class="text-sm font-semibold uppercase tracking-wide text-primary">{eyebrow}</p>
    )}
    <HeadingTag class={headingClasses}>{title}</HeadingTag>
    {subtext && (
      <p class="text-lg text-text-secondary max-w-2xl">{subtext}</p>
    )}
  </div>
</div>