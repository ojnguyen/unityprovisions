---
import { cn } from '@utils/cn';

interface Props {
  padding?: 'sm' | 'md' | 'lg';
  bg?: 'surface' | 'bg';
}

const { padding = 'md', bg = 'surface' } = Astro.props as Props;

// Presets keep card spacing consistent across the site.
const paddingSizes: Record<'sm' | 'md' | 'lg', string> = {
  sm: 'p-4',
  md: 'p-6',
  lg: 'p-8',
};

// Supports either the elevated surface color or the page background color.
const bgColors: Record<'surface' | 'bg', string> = {
  surface: 'bg-surface',
  bg: 'bg-bg',
};

const classes = cn(
  bgColors[bg],
  'rounded-md shadow-sm',
  paddingSizes[padding]
);
---

<!-- [CARD]
- Provides a consistent surface for grouping related content.
- Padding and background color are selected through component props.
-->
<div class={classes}>
  <slot />
</div>