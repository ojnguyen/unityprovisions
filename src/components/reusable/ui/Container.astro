---
import { cn } from '@utils/cn';

interface Props {
  as?: keyof HTMLElementTagNameMap;
  maxWidth?: string;
}

// The wider default keeps desktop sections from feeling unnecessarily narrow.
const { as: Tag = 'div', maxWidth = 'max-w-[90rem]' } = Astro.props as Props;

const classes = cn(maxWidth, 'mx-auto px-4 sm:px-6 lg:px-8');
---

<!-- [CONTAINER]
- Centers content within a configurable maximum width.
- The slot holds the page section or content being constrained.
-->
<Tag class={classes}>
  <slot />
</Tag>