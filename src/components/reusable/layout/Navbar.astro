---
import Container from '@components/reusable/ui/Container.astro';
import Button from '@components/reusable/ui/Button.astro';
import ResponsiveImage from '@components/reusable/ui/ResponsiveImage.astro';
import logoMark from '@assets/icons/logo.webp';
import { navigation, orgName } from '@data/navigation';
import { Icon } from 'astro-icon/components';

const currentPath = Astro.url.pathname;
---

<!-- [NAVBAR]
- Provides desktop navigation, a responsive mobile menu, and the donate CTA.
- The sticky header changes its padding and background treatment as the page scrolls.
-->
<header
  id="site-header"
  data-scrolled="false"
  class="group sticky top-0 z-50 bg-surface shadow-sm transition-[background-color] duration-300 data-[scrolled=true]:bg-text-secondary/30 data-[scrolled=true]:backdrop-blur-sm"
>
  <Container>
    <nav aria-label="Primary">
      <div class="flex items-center justify-between py-4 transition-[padding] duration-300 group-data-[scrolled=true]:py-2">
        <a href="/" class="flex items-center gap-3 text-xl font-bold text-text-primary">
          <ResponsiveImage
            src={logoMark}
            alt=""
            width={logoMark.width}
            height={logoMark.height}
            loading="eager"
            class="h-14 w-auto transition-[height] duration-300 group-data-[scrolled=true]:h-10"
          />
          {orgName}
        </a>

        <ul class="hidden md:flex md:items-center md:gap-6">
          {navigation.map((item) => {
            const isActive = item.href === currentPath;
            const isDonate = item.href === '/donate';
            return (
              <li>
                {isDonate ? (
                  <Button href={item.href} variant="accent" size="sm">
                    {item.label}
                  </Button>
                ) : (
                  <a
                    href={item.href}
                    aria-current={isActive ? 'page' : undefined}
                    class={
                      isActive
                        ? 'rounded-full bg-border-interactive/40 px-3 py-1 font-medium text-text-primary'
                        : 'rounded-full px-3 py-1 font-medium text-text-primary hover:bg-border-interactive/10'
                    }
                  >
                    {item.label}
                  </a>
                )}
              </li>
            );
          })}
        </ul>

        <button
          id="nav-toggle"
          type="button"
          aria-expanded="false"
          aria-controls="mobile-menu"
          aria-label="Toggle navigation menu"
          class="inline-flex items-center justify-center rounded-sm p-2 text-text-primary hover:text-primary md:hidden"
        >
          <Icon name="lucide:menu" data-icon="menu" aria-hidden="true" class="h-6 w-6" />
          <Icon name="lucide:x" data-icon="close" aria-hidden="true" class="hidden h-6 w-6" />
        </button>
      </div>

      <ul id="mobile-menu" hidden class="pb-4 md:hidden">
        {navigation.map((item) => {
          const isActive = item.href === currentPath;
          const isDonate = item.href === '/donate';
          return (
            <li>
              {isDonate ? (
                <div class="py-2">
                  <Button href={item.href} variant="accent" size="sm">
                    {item.label}
                  </Button>
                </div>
              ) : (
                <a
                  href={item.href}
                  aria-current={isActive ? 'page' : undefined}
                  class={
                    isActive
                      ? 'block rounded-md bg-border-interactive/40 px-3 py-3 font-medium text-text-primary'
                      : 'block rounded-md px-3 py-3 font-medium text-text-primary hover:bg-border-interactive/10'
                  }
                >
                  {item.label}
                </a>
              )}
            </li>
          );
        })}
      </ul>
    </nav>
  </Container>
</header>

<script>
  /*
   * The menu controls below are only used on small screens; the desktop menu
   * is shown and hidden through CSS. The scroll behavior applies at every
   * screen size because the sticky header follows the page position.
  */

  const toggle = document.getElementById('nav-toggle');
  const menuIcon = toggle?.querySelector('[data-icon="menu"]');
  const closeIcon = toggle?.querySelector('[data-icon="close"]');
  const menu = document.getElementById('mobile-menu');

  // Opens the menu, swaps the icons, and focuses the first link.
  function openMenu() {
    menu?.removeAttribute('hidden');
    toggle?.setAttribute('aria-expanded', 'true');
    menuIcon?.classList.add('hidden');
    closeIcon?.classList.remove('hidden');
    menu?.querySelector('a')?.focus();
  }

  // Closes the menu and restores the hamburger icon.
  function closeMenu() {
    menu?.setAttribute('hidden', '');
    toggle?.setAttribute('aria-expanded', 'false');
    menuIcon?.classList.remove('hidden');
    closeIcon?.classList.add('hidden');
  }

  // Listener that switches between the open and closed menu states.
  toggle?.addEventListener('click', () => {
    const isOpen = toggle.getAttribute('aria-expanded') === 'true';
    isOpen ? closeMenu() : openMenu();
  });

  // Lets keyboard users close the menu with Escape and return to the toggle.
  menu?.addEventListener('keydown', (event) => {
    if (event.key === 'Escape') {
      closeMenu();
      toggle?.focus();
    }
  });

  /*
   * Scrolling only changes the data-scrolled attribute; the Tailwind classes
   * above handle the header's padding, tint, blur, and logo size. The separate
   * enter and exit values leave a small dead zone, preventing tiny movements
   * near one threshold from making the header flicker.
  */
  const header = document.getElementById('site-header');
  const SCROLL_ENTER = 50; // px — must exceed this to become "scrolled"
  const SCROLL_EXIT = 10; // px — must drop below this to leave "scrolled"

  // Updates the header only when the scroll position crosses a threshold.
  function updateScrolled() {
    const isScrolled = header?.getAttribute('data-scrolled') === 'true';
    const scrollY = window.scrollY;

    if (!isScrolled && scrollY > SCROLL_ENTER) {
      header?.setAttribute('data-scrolled', 'true');
    } else if (isScrolled && scrollY < SCROLL_EXIT) {
      header?.setAttribute('data-scrolled', 'false');
    }
  }

  /*
   * Prevents the scroll handler from scheduling multiple updates before the browser
   * has had a chance to render the next frame. The first scroll event schedules
   * updateScrolled() with requestAnimationFrame and sets ticking to true; any
   * additional scroll events before that frame are ignored. Once updateScrolled()
   * runs, ticking is reset to false so the next frame can be scheduled. This keeps
   * scroll handling synchronized with the browser's rendering cycle instead of
   * running updateScrolled() for every individual scroll event.
   * (Kind of like a MUTEX lock)
  */
  let ticking = false;
  window.addEventListener(
    'scroll',
    () => {
      if (!ticking) {
        requestAnimationFrame(() => {
          updateScrolled();
          ticking = false;
        });
        ticking = true;
      }
    },
    { passive: true }
  );

  // Set the right state when the page loads at a non-zero scroll position.
  header?.setAttribute('data-scrolled', String(window.scrollY > SCROLL_ENTER));
</script>