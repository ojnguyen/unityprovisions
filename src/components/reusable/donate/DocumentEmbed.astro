---
import Container from '@components/reusable/ui/Container.astro';
import SectionHeading from '@components/reusable/ui/SectionHeading.astro';

interface Props {
  heading: string;
  subtext: string;
}

// Required, no defaults — same "page supplies real copy" convention as
// every other section component (project-roadmap.md §7).
const { heading, subtext } = Astro.props as Props;

// Fixed destination, not a prop — same reasoning as QRCodeDonate's
// donateUrl (§7): always the org's real Donations tracking sheet.
//
// This is the exact same sheet ImpactStats.astro reads from (same ID)
// — resolves §10's open "what does the live site's Donation Tracker
// actually embed?" question: it's this sheet, not a separate
// third-party service.
//
// /preview (not the /edit link the sheet is normally shared as) is
// Google's actual embeddable view — the interactive /edit UI blocks
// being framed by another site outright. /preview is built for exactly
// this and just needs the same "Anyone with the link – Viewer" sharing
// ImpactStats already requires on this same sheet (§10).
const sheetEmbedUrl =
  'https://docs.google.com/spreadsheets/d/14C4v_A39CNRhI9oQ-i7GHagwggTS3jptgRGuu5UD6_w/preview';
---

<Container as="section">
  <div class="flex flex-col items-center gap-2 pt-12 pb-4 text-center md:pt-16 md:pb-6">
    <SectionHeading title={heading} subtext={subtext} align="center" />
  </div>
</Container>

<!-- Same bordered-frame-inside-a-sage-band pattern as ProjectSection's embed (§7/§11). -->
<div class="border-y border-border bg-surface">
  <Container as="section">
    <div class="flex flex-col items-center gap-6 py-10 md:py-14">
      <div class="w-full max-w-3xl overflow-hidden rounded-md border border-border bg-bg">
        <iframe
          src={sheetEmbedUrl}
          title="Unity Provisions Donation Tracker"
          loading="lazy"
          class="h-[400px] w-full sm:h-[500px] md:h-[600px]"
        />
      </div>
    </div>
  </Container>
</div>