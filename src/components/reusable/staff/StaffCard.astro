---
import Card from '@components/reusable/ui/Card.astro';
import ResponsiveImage from '@components/reusable/ui/ResponsiveImage.astro';
import { Icon } from 'astro-icon/components';
import { getImageDimensions } from '@utils/images';
import type { StaffMember } from '@/types';

type Props = StaffMember;

const { name, role, email, photo } = Astro.props as Props;

// Fixed 160px (h-40/w-40) display box, whether or not a real `photo`
// is set, so the placeholder avatar below and a real headshot occupy
// exactly the same footprint — no layout shift when photos arrive.
// radius="md" matches every other photo/logo on the site (founder
// photo, partner logos) rather than a circular avatar, which would be
// a new, one-off visual pattern nothing else here uses.
//
// ResponsiveImage is asked to generate the photo at its own real, full
// native resolution — not the 160px display size — so the source
// stays sharp. Display size is a separate, CSS-only concern (h-40 w-40
// below), decoupled from whatever resolution was requested; see
// PartnersAndSupporters, §7, where tying the two together (either
// direction) caused real problems. object-cover (not PartnersAndSupporters'
// object-contain) is deliberate here — a headshot cropping to fill a
// square avatar is the normal, desired look, unlike a logo, which must
// never be cropped.
const STRING_PHOTO_FALLBACK = { width: 320, height: 400 };

const photoDims = photo ? getImageDimensions(photo, STRING_PHOTO_FALLBACK) : null;
---
<Card padding="md">
  <div class="flex flex-col items-center gap-3 text-center">
    {photo && photoDims ? (
      <ResponsiveImage
        src={photo}
        alt={name}
        width={photoDims.width}
        height={photoDims.height}
        radius="md"
        class="h-40 w-40 object-cover"
      />
    ) : (
      <span
        class="flex h-40 w-40 items-center justify-center rounded-md bg-primary/10 text-primary"
        aria-hidden="true"
      >
        <Icon name="lucide:user" class="h-20 w-20" />
      </span>
    )}

    <div>
      <p class="font-semibold text-text-primary">{name}</p>
      <p class="text-sm text-text-secondary">{role}</p>
    </div>

    {email && (
      <a
        href={`mailto:${email}`}
        class="inline-flex items-center gap-1.5 text-sm text-primary hover:text-primary-hover"
      >
        <Icon name="lucide:mail" aria-hidden="true" class="h-3.5 w-3.5" />
        {email}
      </a>
    )}
  </div>
</Card>