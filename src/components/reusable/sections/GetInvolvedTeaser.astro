---
import Container from '@components/reusable/ui/Container.astro';
import SectionHeading from '@components/reusable/ui/SectionHeading.astro';
import Button from '@components/reusable/ui/Button.astro';

interface Props {
  heading: string;
  subtext: string;
  ctaLabel: string;
  icon?: string;
}

const { heading, subtext, ctaLabel, icon } = Astro.props as Props;
---

<!-- [GET INVOLVED TEASER]
- Introduces the get-involved page with a heading, supporting text, and CTA.
- The destination stays fixed so this teaser always leads to the same next step.
-->
<Container as="section">
  <div class="flex flex-col items-center gap-6 py-12 text-center md:py-16">
    <SectionHeading icon={icon} title={heading} subtext={subtext} align="center" />
    <Button href="/get-involved" variant="primary" size="md">
      {ctaLabel}
    </Button>
  </div>
</Container>