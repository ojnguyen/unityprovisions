---
import Container from '@components/reusable/ui/Container.astro';
import Button from '@components/reusable/ui/Button.astro';
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  headline: string;
  tagline: string;
  ctaLabel: string;
  ctaHref: string;
  subtext?: string; // Optional supporting line under the headline.
  secondaryCtaLabel?: string; // Optional lower-emphasis action label shown beside the main CTA
  secondaryCtaHref?: string; // Link for above
  backgroundImage?: ImageMetadata; // Optional real photo for the hero background; falls back to a gradient
}

const {
  headline,
  tagline,
  ctaLabel,
  ctaHref,
  subtext,
  secondaryCtaLabel,
  secondaryCtaHref,
  backgroundImage,
} = Astro.props as Props;

const hasSecondaryCta = Boolean(secondaryCtaLabel && secondaryCtaHref);
---

<!-- [HERO]
- Shows the main message, optional supporting text, and primary call to action.
- Uses a supplied photo when available and a layered color background as a fallback.
-->
<div class="relative isolate overflow-hidden bg-text-primary">
  {backgroundImage ? (
    <div class="absolute inset-0 -z-10">
      <Image
        src={backgroundImage}
        alt=""
        width={1920}
        height={1080}
        loading="eager"
        class="h-full w-full object-cover mask-y-from-accent"
      />
    </div>
  ) : (
    <div class="absolute inset-0 -z-10 bg-linear-to-br from-primary via-primary to-primary-hover">
      <div class="pointer-events-none absolute -top-24 -left-24 h-72 w-72 rounded-full bg-white/10 blur-3xl"></div>
      <div class="pointer-events-none absolute -right-16 bottom-0 h-96 w-96 rounded-full bg-accent/25 blur-3xl"></div>
    </div>
  )}

  <Container as="section">
    <div class="flex flex-col items-center gap-6 py-24 text-center md:py-32">
      <p class="text-sm font-semibold uppercase tracking-wide text-white/80">
        {tagline}
      </p>
      <h1 class="max-w-3xl text-3xl font-bold text-white">
        {headline}
      </h1>
      {subtext && (
        <p class="max-w-xl text-lg text-white/85">
          {subtext}
        </p>
      )}
      <div class="flex flex-col items-center gap-3 sm:flex-row">
        <Button href={ctaHref} variant="accent" size="lg">
          {ctaLabel}
        </Button>
        {hasSecondaryCta && (
          <a
            href={secondaryCtaHref}
            class="inline-flex items-center justify-center rounded-sm border border-white/70 px-6 py-3 text-lg font-medium text-white transition-colors duration-150 hover:bg-white/10"
          >
            {secondaryCtaLabel}
          </a>
        )}
      </div>
    </div>
  </Container>
</div>