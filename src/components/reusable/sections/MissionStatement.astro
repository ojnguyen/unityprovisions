---
import Container from '@components/reusable/ui/Container.astro';
import SectionHeading from '@components/reusable/ui/SectionHeading.astro';

interface Props {
  heading: string;
  body: string;
  icon?: string;
}

const { heading, body, icon } = Astro.props as Props;
---

<!-- [MISSION STATEMENT]
- Centers the mission heading, optional icon, and supporting body copy.
-->
<Container as="section">
  <div class="flex flex-col items-center gap-6 py-12 text-center md:py-16">
    <SectionHeading icon={icon} title={heading} align="center" />
    <p class="max-w-3xl text-lg text-text-secondary">
      {body}
    </p>
  </div>
</Container>