---
import Container from '@components/reusable/ui/Container.astro';
import SectionHeading from '@components/reusable/ui/SectionHeading.astro';
import Card from '@components/reusable/ui/Card.astro';
import Button from '@components/reusable/ui/Button.astro';
import { Icon } from 'astro-icon/components';
import { cn } from '@utils/cn';

interface Props {
  heading: string;
  subtext?: string;
}

// Required, no defaults — same pattern as every other Home section
// component. Real copy is supplied by index.astro at assembly time.
const { heading, subtext } = Astro.props as Props;

// border-border-interactive (not border-border) + bg-bg (not bg-surface):
// --color-border only clears ~1.2-1.35:1 against bg/surface, well under
// WCAG 1.4.11's 3:1 minimum for interactive-element boundaries, and a
// bg-surface input inside this panel's bg-surface Card had no fill
// contrast against its own container either. See global.css and
// project-roadmap.md §6/§9 for the audit that found this.
const inputClasses = cn(
  'w-full rounded-sm border border-border-interactive bg-bg px-3 py-2 text-base text-text-primary'
);

const labelClasses = 'flex flex-col gap-1.5 text-sm font-medium text-text-primary';
---
<Container as="section">
  <div class="flex flex-col items-center gap-6 py-12 md:py-16">
    <SectionHeading title={heading} subtext={subtext} align="center" />
    <a href="mailto:contact@unityprovisions.org" class="inline-flex items-center gap-2 text-primary hover:text-primary-hover">
      <Icon name="lucide:mail" aria-hidden="true" class="h-4 w-4" />
      contact@unityprovisions.org
    </a>

    <!-- Collapsed state: only this button shows until a visitor opts in. -->
    <div id="contact-trigger-wrapper">
      <Button type="button" variant="primary" size="lg">Drop Us a Line!</Button>
    </div>

    <!-- Expanded state: hidden by default, revealed by the trigger above. -->
    <div id="contact-panel" hidden class="w-full max-w-xl">
      <Card padding="lg">
        <form id="contact-form" class="flex flex-col gap-5">
          <!-- Formspree special field: sets the notification email's subject line. -->
          <input type="hidden" name="_subject" value="New message from Unity Provisions website contact form" />

          <label class={labelClasses} for="contact-name">
            Name <span aria-hidden="true">*</span>
            <input
              id="contact-name"
              name="name"
              type="text"
              autocomplete="name"
              required
              class={inputClasses}
            />
          </label>

          <label class={labelClasses} for="contact-email">
            Email <span aria-hidden="true">*</span>
            <input
              id="contact-email"
              name="email"
              type="email"
              autocomplete="email"
              required
              class={inputClasses}
            />
          </label>

          <label class={labelClasses} for="contact-message">
            Message <span aria-hidden="true">*</span>
            <textarea
              id="contact-message"
              name="message"
              rows="5"
              required
              placeholder="How can we help you?"
              class={cn(inputClasses, 'resize-y')}
            ></textarea>
          </label>

          <label class={labelClasses} for="contact-referral">
            Where did you hear about us?
            <input
              id="contact-referral"
              name="referral"
              type="text"
              class={inputClasses}
            />
          </label>

          <!-- Shown only if the fetch() below fails or errors. role="alert" announces it to screen readers immediately. -->
          <p id="contact-error" hidden role="alert" class="text-sm text-error">
            Something went wrong sending your message. Please try again, or email us directly at contact@unityprovisions.org.
          </p>

          <p class="text-xs text-text-secondary">* required field</p>

          <div class="flex gap-3">
            <Button type="submit" variant="primary">Send</Button>
            <Button type="button" variant="secondary">Cancel</Button>
          </div>
        </form>

        <!--
          Success state: swaps in for the form itself once Formspree
          confirms the submission. Lives in the same Card, as a sibling
          of <form> rather than inside it, so it's never picked up by
          FormData(form) and never renders while the form is in use.
        -->
        <div id="contact-success" hidden tabindex="-1" class="flex flex-col items-center gap-3 py-4 text-center">
          <Icon name="lucide:check-circle-2" aria-hidden="true" class="h-8 w-8 text-primary" />
          <p class="text-text-primary">Thanks for reaching out — we'll get back to you soon.</p>
          <div id="contact-success-close-wrapper">
            <Button type="button" variant="secondary">Close</Button>
          </div>
        </div>
      </Card>
    </div>
  </div>
</Container>

<script>
  // Progressive disclosure: the form stays collapsed behind a single
  // "Drop Us a Line!" button until a visitor actually wants to use it —
  // matching the live site's real behavior, and reusing the same
  // accessible disclosure pattern already used for Navbar's mobile menu
  // (aria-expanded/aria-controls on the trigger, focus moves into the
  // panel on open and back to the trigger on close, Escape closes).
  const triggerWrapper = document.getElementById('contact-trigger-wrapper');
  const triggerButton = triggerWrapper?.querySelector('button');
  const panel = document.getElementById('contact-panel');
  const form = document.getElementById('contact-form') as HTMLFormElement | null;
  const errorMessage = document.getElementById('contact-error');
  const successMessage = document.getElementById('contact-success');

  // Button.astro doesn't accept an id prop (see project-roadmap.md §7),
  // so aria-expanded/aria-controls, and every button below, are found/
  // targeted via querySelector instead of by id.
  triggerButton?.setAttribute('aria-expanded', 'false');
  triggerButton?.setAttribute('aria-controls', 'contact-panel');

  function openForm() {
    panel?.removeAttribute('hidden');
    triggerWrapper?.setAttribute('hidden', '');
    triggerButton?.setAttribute('aria-expanded', 'true');
    panel?.querySelector<HTMLInputElement | HTMLTextAreaElement>('input, textarea')?.focus();
  }

  function closeForm() {
    panel?.setAttribute('hidden', '');
    triggerWrapper?.removeAttribute('hidden');
    triggerButton?.setAttribute('aria-expanded', 'false');
    form?.reset();
    form?.removeAttribute('hidden');
    errorMessage?.setAttribute('hidden', '');
    successMessage?.setAttribute('hidden', '');
    triggerButton?.focus();
  }

  triggerButton?.addEventListener('click', openForm);

  // Cancel is the only type="button" inside <form> itself, so this
  // finds it without Button.astro needing an id prop — same workaround
  // used throughout this component (see project-roadmap.md §7).
  const cancelButton = form?.querySelector('button[type="button"]');
  cancelButton?.addEventListener('click', closeForm);

  // The success state's "Close" button lives outside <form> (see markup
  // comment above), so it needs its own wrapper-id lookup rather than
  // the form?.querySelector used for Cancel above.
  const successCloseButton = document
    .getElementById('contact-success-close-wrapper')
    ?.querySelector('button');
  successCloseButton?.addEventListener('click', closeForm);

  panel?.addEventListener('keydown', (event) => {
    if (event.key === 'Escape') {
      closeForm();
    }
  });

  // Formspree endpoint (from the form's Integration tab) — live as of
  // project-roadmap.md §7/§10.
  const FORMSPREE_ENDPOINT = 'https://formspree.io/f/xbgravll';

  const submitButton = form?.querySelector<HTMLButtonElement>('button[type="submit"]');

  form?.addEventListener('submit', async (event) => {
    event.preventDefault();
    if (!form) return;

    errorMessage?.setAttribute('hidden', '');
    if (submitButton) {
      submitButton.disabled = true;
      submitButton.textContent = 'Sending…';
    }

    try {
      // Accept: application/json makes Formspree respond with JSON
      // instead of redirecting to its own hosted thank-you page —
      // required for a same-page AJAX success/error flow.
      const response = await fetch(FORMSPREE_ENDPOINT, {
        method: 'POST',
        body: new FormData(form),
        headers: { Accept: 'application/json' },
      });

      if (!response.ok) {
        throw new Error(`Formspree responded with ${response.status}`);
      }

      form.setAttribute('hidden', '');
      successMessage?.removeAttribute('hidden');
      successMessage?.focus();
    } catch (error) {
      console.error('ContactForm: submission failed', error);
      errorMessage?.removeAttribute('hidden');
    } finally {
      if (submitButton) {
        submitButton.disabled = false;
        submitButton.textContent = 'Send';
      }
    }
  });
</script>