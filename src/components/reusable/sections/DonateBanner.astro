---
import Container from '@components/reusable/ui/Container.astro';
import Button from '@components/reusable/ui/Button.astro';

interface Props {
  heading: string;
  subtext: string;
  ctaLabel: string;
}

const { heading, subtext, ctaLabel } = Astro.props as Props;
---

<!-- [DONATE BANNER]
- Ends a section with a short donation message and a prominent CTA.
- The CTA always leads to the site's donation page.
-->
<div class="bg-primary-hover">
  <Container as="section">
    <div class="flex flex-col items-center gap-6 py-16 text-center md:py-20">
      <h2 class="max-w-2xl text-2xl font-bold text-white">
        {heading}
      </h2>
      <p class="max-w-2xl text-lg text-white/80">
        {subtext}
      </p>
      <Button href="/donate" variant="accent" size="lg">
        {ctaLabel}
      </Button>
    </div>
  </Container>
</div>