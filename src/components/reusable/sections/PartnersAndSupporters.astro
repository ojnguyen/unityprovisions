---
import Container from '@components/reusable/ui/Container.astro';
import Card from '@components/reusable/ui/Card.astro';
import ResponsiveImage from '@components/reusable/ui/ResponsiveImage.astro';
import type { Partner } from '@/types';
import { getImageDimensions } from '@utils/images';
import { Icon } from 'astro-icon/components';

interface Props {
  partners: Partner[];
  // Intro text switches its group to the detailed card-grid layout.
  partnersIntro?: string;
  supportersIntro?: string;
}

const { partners, partnersIntro, supportersIntro } = Astro.props as Props;

// Treats entries without a type as partners by default.
const partnerOrgs = partners.filter((org) => org.type !== 'supporter');
const supporterOrgs = partners.filter((org) => org.type === 'supporter');

// Builds one renderable list and skips groups with no organizations.
const groups = [
  { label: 'Partners', orgs: partnerOrgs, intro: partnersIntro },
  { label: 'Supporters', orgs: supporterOrgs, intro: supportersIntro },
].filter((group) => group.orgs.length > 0);

// Generates logos at source dimensions while CSS controls their fixed display boxes.
const STRING_LOGO_FALLBACK = { width: 240, height: 80 };
---

<!-- [PARTNERS AND SUPPORTERS]
- Separates organizations into partner and supporter groups.
- Intro text selects a detailed card grid; without it, the group uses a compact logo row.
-->
<!-- Full-bleed surface band containing the grouped organization listings. -->
<div class="border-y border-border bg-surface">
  <Container as="section">
    <div class="flex flex-col gap-10 py-12 md:py-16">
      <!-- Each populated organization group gets its own heading and listing. -->
      <!-- Intro text selects detailed cards; otherwise the group uses a compact logo row. -->
      {groups.map((group) => (
        <div class="flex flex-col items-center gap-4 text-center">
          <h3 class="text-sm font-semibold uppercase tracking-wide text-primary">
            {group.label}
          </h3>

          {group.intro && (
            <p class="max-w-2xl text-base text-text-secondary">
              {group.intro}
            </p>
          )}

          {group.intro ? (
            <div class="grid w-full grid-cols-2 gap-4 sm:grid-cols-3 md:grid-cols-4">
              {group.orgs.map((org) => {
                const dims = org.logo ? getImageDimensions(org.logo, STRING_LOGO_FALLBACK) : null;
                return (
                  <Card padding="md" bg="bg">
                    <div class="flex flex-col items-center gap-2 text-center">
                      {org.logo && dims ? (
                        <ResponsiveImage
                          src={org.logo}
                          alt={org.name}
                          width={dims.width}
                          height={dims.height}
                          radius="none"
                          class="h-12 w-12 object-contain"
                        />
                      ) : (
                        <Icon name="lucide:building-2" aria-hidden="true" class="h-8 w-8 text-primary/60" />
                      )}
                      <span class="text-sm font-medium text-text-primary">{org.name}</span>
                    </div>
                  </Card>
                );
              })}
            </div>
          ) : (
            <div class="flex flex-wrap items-center justify-center gap-3">
              {group.orgs.map((org) => {
                const dims = org.logo ? getImageDimensions(org.logo, STRING_LOGO_FALLBACK) : null;
                return org.logo && dims ? (
                  <ResponsiveImage
                    src={org.logo}
                    alt={org.name}
                    width={dims.width}
                    height={dims.height}
                    radius="none"
                    class="h-10 w-10 object-contain"
                  />
                ) : (
                  <span class="inline-flex items-center gap-1.5 rounded-sm border border-border px-3 py-1.5 text-sm text-text-secondary">
                    <Icon name="lucide:building-2" aria-hidden="true" class="h-3.5 w-3.5 text-primary/60" />
                    {org.name}
                  </span>
                );
              })}
            </div>
          )}
        </div>
      ))}
    </div>
  </Container>
</div>