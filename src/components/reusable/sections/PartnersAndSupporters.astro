---
import Container from '@components/reusable/ui/Container.astro';
import Card from '@components/reusable/ui/Card.astro';
import ResponsiveImage from '@components/reusable/ui/ResponsiveImage.astro';
import { Icon } from 'astro-icon/components';
import { getImageDimensions } from '@utils/images';
import type { Partner } from '@/types';

interface Props {
  partners: Partner[];
  /**
   * Optional framing paragraph shown under each group's heading.
   * Supplying either prop switches that group from Home's compact
   * badge row into a fuller, more detailed card-grid treatment (used
   * by About) — presence of real intro copy is the signal, rather
   * than a separate boolean flag.
   */
  partnersIntro?: string;
  supportersIntro?: string;
}

const { partners, partnersIntro, supportersIntro } = Astro.props as Props;

// An entry with no `type` set is treated as a partner by default.
const partnerOrgs = partners.filter((org) => org.type !== 'supporter');
const supporterOrgs = partners.filter((org) => org.type === 'supporter');

// Grouped into one array so the markup below only needs to loop once,
// instead of repeating the same badge/logo rendering twice. A group is
// skipped entirely if the page passed in zero orgs of that type (e.g.
// a "brief" Home version that only supplies partners).
const groups = [
  { label: 'Partners', orgs: partnerOrgs, intro: partnersIntro },
  { label: 'Supporters', orgs: supporterOrgs, intro: supportersIntro },
].filter((group) => group.orgs.length > 0);

// Logos render through ResponsiveImage (astro:assets), each generated
// at its own real, full native resolution — not a shared guessed size
// — so the source Astro works from is always sharp. A local
// `src/assets/...` import already carries its full real width/height
// on the ImageMetadata object itself, so this reads `.width`/`.height`
// straight off it.
//
// Display size is a completely separate concern, handled in CSS below
// via a FIXED width+height (h-12/w-24, h-10/w-20) + object-contain —
// not just a fixed height with width left to size itself. A logo's
// real, un-guessed proportions are still fully preserved (object-
// contain never stretches; a logo narrower or wider than the box just
// gets letterboxed within it), but the box itself is now identical for
// every logo, so spacing between them is even and predictable
// regardless of each source file's real resolution or aspect ratio —
// leaving that to auto-size (relying on the browser's un-forced "auto"
// width) is what produced the widely uneven spacing this replaces.
const STRING_LOGO_FALLBACK = { width: 240, height: 80 };
---
<div class="border-y border-border bg-surface">
  <Container as="section">
    <div class="flex flex-col gap-10 py-12 md:py-16">
      {groups.map((group) => (
        <div class="flex flex-col items-center gap-4 text-center">
          <h3 class="text-sm font-semibold uppercase tracking-wide text-primary">
            {group.label}
          </h3>

          {group.intro && (
            <p class="max-w-2xl text-base text-text-secondary">
              {group.intro}
            </p>
          )}

          {group.intro ? (
            <div class="grid w-full grid-cols-2 gap-4 sm:grid-cols-3 md:grid-cols-4">
              {group.orgs.map((org) => {
                const dims = org.logo ? getImageDimensions(org.logo, STRING_LOGO_FALLBACK) : null;
                return (
                  <Card padding="md" bg="bg">
                    <div class="flex flex-col items-center gap-2 text-center">
                      {org.logo && dims ? (
                        <ResponsiveImage
                          src={org.logo}
                          alt={org.name}
                          width={dims.width}
                          height={dims.height}
                          radius="none"
                          class="h-12 w-12 object-contain"
                        />
                      ) : (
                        <Icon name="lucide:building-2" aria-hidden="true" class="h-8 w-8 text-primary/60" />
                      )}
                      <span class="text-sm font-medium text-text-primary">{org.name}</span>
                    </div>
                  </Card>
                );
              })}
            </div>
          ) : (
            <div class="flex flex-wrap items-center justify-center gap-3">
              {group.orgs.map((org) => {
                const dims = org.logo ? getImageDimensions(org.logo, STRING_LOGO_FALLBACK) : null;
                return org.logo && dims ? (
                  <ResponsiveImage
                    src={org.logo}
                    alt={org.name}
                    width={dims.width}
                    height={dims.height}
                    radius="none"
                    class="h-10 w-10 object-contain"
                  />
                ) : (
                  <span class="inline-flex items-center gap-1.5 rounded-sm border border-border px-3 py-1.5 text-sm text-text-secondary">
                    <Icon name="lucide:building-2" aria-hidden="true" class="h-3.5 w-3.5 text-primary/60" />
                    {org.name}
                  </span>
                );
              })}
            </div>
          )}
        </div>
      ))}
    </div>
  </Container>
</div>