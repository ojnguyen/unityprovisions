---
import Container from '@components/reusable/ui/Container.astro';
import type { Stat } from '@/types';
import { Icon } from 'astro-icon/components';

interface Props {
  stats: Stat[];
}

const { stats } = Astro.props as Props;

/*
 * Live values come from the public "Donations Overview" Google Sheet.
 * JSONP is used instead of fetch because the gviz endpoint does not allow
 * cross-origin requests, while a script tag can load the response directly.
 *
 * The query selects only the expected labels from columns B and C. This keeps
 * unrelated tables on the same tab from being mistaken for summary values.
 * Stats without a liveSheetLabel, or without a matching sheet row, keep their
 * original values from the stats prop.
 *
 * The sheet must be shared as "Anyone with the link - Viewer".
*/

const SHEET_ID = '14C4v_A39CNRhI9oQ-i7GHagwggTS3jptgRGuu5UD6_w';
const SHEET_GID = '638911803'; // the "Donations Overview" tab

/*
 * Keeps the range limited to the summary block. The tab's donation log starts
 * at row 7, and including it can make Google's inferred column type treat the
 * summary labels as non-strings, causing the WHERE match to return nothing.
 * Update the range if the summary block gains or loses rows.
*/
const SHEET_RANGE = 'B1:C6';

// LIVE_LABELS is Total (lbs) and Money Collected ($)
const LIVE_LABELS = stats
  .map((stat) => stat.liveSheetLabel)
  .filter((label): label is string => typeof label === 'string' && label.length > 0);
---

<!-- [IMPACT STATS]
- Shows the impact numbers in a simple responsive grid.
- Numbers linked to the sheet are updated after the page loads.
-->
<div class="border-y border-border bg-surface">
  <Container as="section">
    <dl class="grid grid-cols-2 gap-8 py-10 text-center md:grid-cols-4 md:py-14">
      {stats.map((stat) => (
        <div class="flex flex-col items-center gap-1" data-live-label={stat.liveSheetLabel}>
          {stat.icon && (
            <Icon name={stat.icon} aria-hidden="true" class="mb-1 h-6 w-6 text-primary/70" />
          )}
          <dt class="text-3xl font-bold text-primary">{stat.value}</dt>
          <dd class="text-sm text-text-secondary">{stat.label}</dd>
        </div>
      ))}
    </dl>
  </Container>
</div>

<script define:vars={{ SHEET_ID, SHEET_GID, SHEET_RANGE, LIVE_LABELS }}>
  /*
   * A NodeList of all the <div> elements in the stat grid that have a 'data-live-label' attribute.
   * Each of those elements corresponds to a stat that should be update with live data from the Google Sheet.
   * If no elements or LIVE_LABELS empty, do nothing.
  */
  const liveEls = document.querySelectorAll('[data-live-label]');

  if (liveEls.length > 0 && LIVE_LABELS.length > 0) {
    loadLiveStats();
  }

  /*
   * Google Sheets' gviz endpoint does not allow the cross-origin fetch or XHR
   * request we would normally use here. Loading the URL as a script gets around
   * that browser restriction because script elements are allowed to load remote
   * resources. The endpoint then calls the named global function with the sheet
   * response, which is the JSONP part of this helper.
   *
   * The callback removes itself and the temporary script as soon as the response
   * arrives. If the script fails to load, the same cleanup runs before rejecting
   * the promise so a failed request does not leave a global callback or unused
   * script element behind. The caller can then keep the fallback values already
   * rendered into the page.
  */
  function fetchGvizJsonp(url) {
    return new Promise((resolve, reject) => {
      const callbackName = '__unityImpactStatsCallback';

      function cleanup() {
        delete window[callbackName];
        script.remove();
      }

      window[callbackName] = (response) => {
        cleanup();
        resolve(response);
      };

      const script = document.createElement('script');
      script.src = url;
      script.onerror = () => {
        cleanup();
        reject(new Error('Failed to load the sheet.'));
      };
      document.head.append(script);
    });
  }

  // Escapes a string for a single-quoted Google Visualization query literal.
  function escapeForQuery(str) {
    return str.replace(/\\/g, '\\\\').replace(/'/g, "\\'");
  }

  // Normalizes labels before comparing values from the sheet and the DOM.
  function normalize(str) {
    return String(str ?? '')
      .replace(/\s+/g, ' ')
      .trim()
      .toLowerCase();
  }

  // Queries the sheet and updates each matching stat value in place.
  async function loadLiveStats() {
    // Equivalent SQL Query: SELECT B, C WHERE B = 'Total (lbs)' OR B = 'Money Collected ($)'
    const whereClause = LIVE_LABELS.map((label) => `B = '${escapeForQuery(label)}'`).join(' OR ');
    const query = `SELECT B, C WHERE ${whereClause}`;

    /*
     * Builds the gviz URL with the sheet tab, narrow range, query, and JSONP
     * callback. The range is intentionally kept separate from the query.
    */
    const url =
      `https://docs.google.com/spreadsheets/d/${SHEET_ID}/gviz/tq` + // The base URL for the Google Sheets gviz endpoint, with the sheet ID.
      `?gid=${SHEET_GID}` + // The GID of the sheet tab to query.
      `&range=${encodeURIComponent(SHEET_RANGE)}` + // The range of cells to query.
      `&tq=${encodeURIComponent(query)}` + // The query string, URL-encoded.
      `&tqx=out:json;responseHandler:__unityImpactStatsCallback`; // The output format and callback function name.

    try {
      const response = await fetchGvizJsonp(url);
      // console.log('ImpactStats: live sheet response', response);

      if (response.status === 'error') {
        throw new Error(
          `Sheet query failed: ${JSON.stringify(response.errors)}. Query used: ${query}`
        );
      }

      // Builds a normalized-label to formatted-value lookup from the filtered rows.
      const sheetValues = new Map(); // Map where the key is the normalized label from column B, and the value is the corresponding value from column C.
      for (const row of response.table.rows) {
        const labelCell = row.c && row.c[0]; // The first cell in the response row, which contains the label (column B). NOTE: Google's gviz API returns the columns in the order they were requested in the query, so column B is the first cell in the row.
        const valueCell = row.c && row.c[1]; // The second cell in the response row, which contains the value (column C).
        const rawLabel = String((labelCell && (labelCell.f ?? labelCell.v)) ?? '').trim(); // Label -- preferably formatted but falls back to raw value
        const value = String((valueCell && (valueCell.f ?? valueCell.v)) ?? '').trim(); // Value -- preferably formatted but falls back to raw value
        if (rawLabel) sheetValues.set(normalize(rawLabel), value);  // Store the normalized label and its corresponding value in the map.
      }

      // Replace each opted-in stat value when a matching sheet row exists.
      liveEls.forEach((el) => {
        const key = el.dataset.liveLabel; // The normalized label for this stat, as specified in the `data-live-label` attribute. e.g. "Total (lbs)" or "Money Collected ($)"
        const liveValue = sheetValues.get(normalize(key)); // The value from the sheet corresponding to this normalized label, if found.
        if (liveValue) {
          const dt = el.querySelector('dt'); // The <dt> element inside this stat element, which contains the value to be updated.
          if (dt) dt.textContent = liveValue; // Update the text content of the <dt> element with the live value from the sheet.
        } else {
          console.warn(
            `ImpactStats: Not a valid liveValue OR no sheet row matched liveSheetLabel "${key}". ` +
            `Query used: ${query} — labels found: ${JSON.stringify([...sheetValues.keys()])}`
          );
        }
      });
    } catch (error) {
      // Keep the server-rendered fallback values when the sheet cannot be read.
      console.error('ImpactStats: could not load live stats.', error);
    }
  }
</script>