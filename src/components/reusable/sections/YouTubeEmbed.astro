---
import Container from '@components/reusable/ui/Container.astro';
import SectionHeading from '@components/reusable/ui/SectionHeading.astro';
import ResponsiveImage from '@components/reusable/ui/ResponsiveImage.astro';

interface Props {
  videoId: string;
  title: string;
}

const { videoId, title } = Astro.props as Props;

// URL from YouTube's public thumbnail service. hqdefault.jpg is always
// exactly 480x360 for any video — a real, fixed size, not a guess — so
// it's safe to pass as explicit width/height to ResponsiveImage below.
// Requires i.ytimg.com to be allowlisted in astro.config.mjs's
// `image.domains` — Astro's Image pipeline refuses to process any
// remote domain that isn't explicitly listed here.
const thumbnailUrl = `https://i.ytimg.com/vi/${videoId}/hqdefault.jpg`;
---
<!--
  id="watch-our-story" is the scroll target for Hero's optional
  secondary CTA / scroll-cue (see Hero.astro) — added here rather than
  giving Container an id prop, so Container's API stays generic (§7).

  White heading block (asymmetric padding) + separate full-bleed sage
  band for the actual content — same pattern as ProjectSection/
  QRCodeDonate/DocumentEmbed: sage is reserved for a section's actual
  "content" (here, the video facade), never the heading alone (§6/§11).
-->
<div id="watch-our-story">
  <Container as="section">
    <!--
      pt-8/md:pt-10 (was pt-12/md:pt-16) — trimmed since index.astro
      now puts a Divider directly above this heading (§11: MissionStatement
      and this heading are both white at the seam). pb-4/md:pb-6 unchanged
      — that's the separate, tight gap into this component's own sage
      band just below, unrelated to the new divider above.
    -->
    <div class="flex flex-col items-center gap-2 pt-8 pb-4 text-center md:pt-10 md:pb-6">
      <SectionHeading title={title} align="center" />
    </div>
  </Container>

  <div class="border-y border-border bg-surface">
    <Container as="section">
      <div class="flex flex-col items-center gap-6 py-10 md:py-14">
        <div
          class="relative aspect-video w-full max-w-3xl overflow-hidden rounded-md bg-black"
          data-youtube-facade
          data-video-id={videoId}
          data-title={title}
        >
          <button
            type="button"
            class="group absolute inset-0 flex h-full w-full items-center justify-center"
            aria-label={`Play video: ${title}`}
          >
            <ResponsiveImage
              src={thumbnailUrl}
              alt=""
              width={480}
              height={360}
              loading="lazy"
              radius="none"
              class="absolute inset-0 h-full w-full object-cover"
            />
            <span class="relative z-10 flex h-16 w-16 items-center justify-center rounded-full bg-white/90 transition-transform duration-150 group-hover:scale-110">
              <svg viewBox="0 0 24 24" class="h-6 w-6 translate-x-0.5 fill-text-primary" aria-hidden="true">
                <path d="M8 5v14l11-7z" />
              </svg>
            </span>
          </button>
        </div>
      </div>
    </Container>
  </div>
</div>

<script>
  // Click-to-load facade: nothing from YouTube (iframe, player JS) loads
  // until the visitor actually clicks play. querySelectorAll (not
  // getElementById) so this stays correct if the component is ever used
  // more than once on the same page.
  document.querySelectorAll('[data-youtube-facade]').forEach((facade) => {
    const button = facade.querySelector('button');

    button?.addEventListener('click', () => {
      const videoId = facade.getAttribute('data-video-id'); // Same thing as facade.dataset.videoId
      const title = facade.getAttribute('data-title') ?? 'YouTube video player';

      const iframe = document.createElement('iframe');
      // youtube-nocookie.com avoids setting tracking cookies until the visitor opts in by clicking play.
      iframe.src = `https://www.youtube-nocookie.com/embed/${videoId}?autoplay=1`;
      iframe.title = title;
      iframe.className = 'absolute inset-0 h-full w-full';
      iframe.allow =
        'accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share';
      iframe.allowFullscreen = true;

      // Replace the facade with the iframe, which will start loading and playing the video.
      facade.replaceChildren(iframe);
    });
  });
</script>