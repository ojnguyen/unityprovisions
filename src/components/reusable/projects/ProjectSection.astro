---
import Container from '@components/reusable/ui/Container.astro';
import SectionHeading from '@components/reusable/ui/SectionHeading.astro';
import ResponsiveImage from '@components/reusable/ui/ResponsiveImage.astro';
import ExternalLinkCTA from '@components/reusable/ui/ExternalLinkCTA.astro';
import type { Project } from '@/types';
import { getImageDimensions } from '@utils/images';

type Props = Project;

const {
  title,
  description,
  image,
  imageAlt,
  embedUrl,
  embedTitle,
  ctaLabel,
  ctaHref,
  ctaIcon,
} = Astro.props as Props;

const hasContent = Boolean(image || embedUrl || (ctaLabel && ctaHref));

/*
 * Generate each screenshot at its own source dimensions so it stays sharp
 * and keeps its original aspect ratio. The image fills a single large wrapper,
 * so w-full h-auto is a better fit than a fixed box with object-fit: a fixed
 * box could crop or letterbox the screenshot instead of simply scaling it.
*/
const STRING_IMAGE_FALLBACK = { width: 800, height: 500 };

const imageDims = image ? getImageDimensions(image, STRING_IMAGE_FALLBACK) : null;
---

<!-- [PROJECT SECTION]
- Shows the project title and description, followed by its optional image, embed, and CTA.
- The content band appears only when at least one project detail is available.
-->
<Container as="section">
  <div class="flex flex-col items-center gap-2 pt-12 pb-4 text-center md:pt-16 md:pb-6">
    <SectionHeading title={title} align="center" />
    <p class="max-w-3xl text-lg text-text-secondary">{description}</p>
  </div>
</Container>

{hasContent && (
  <div class="border-y border-border bg-surface">
    <Container as="section">
      <div class="flex flex-col items-center gap-6 py-10 text-center md:py-14">
        {image && imageDims && (
          <div class="w-full max-w-3xl overflow-hidden rounded-md border border-border">
            <ResponsiveImage
              src={image}
              alt={imageAlt ?? `Screenshot of ${title}`}
              width={imageDims.width}
              height={imageDims.height}
              radius="none"
              class="w-full h-auto"
            />
          </div>
        )}

        {embedUrl && (
          <div class="w-full max-w-3xl overflow-hidden rounded-md border border-border bg-bg">
            <iframe
              src={embedUrl}
              title={embedTitle ?? `${title} interactive map`}
              loading="eager"
              class="h-100 w-full sm:h-125 md:h-150"
            />
          </div>
        )}

        {ctaLabel && ctaHref && (
          <ExternalLinkCTA label={ctaLabel} href={ctaHref} icon={ctaIcon} />
        )}
      </div>
    </Container>
  </div>
)}               