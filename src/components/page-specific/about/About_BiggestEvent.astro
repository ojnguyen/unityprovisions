---
import Container from "@components/reusable/ui/Container.astro";
import SectionHeading from "@components/reusable/ui/SectionHeading.astro";
import ResponsiveImage from "@components/reusable/ui/ResponsiveImage.astro";

import bigEventPhoto from "@assets/projects-and-events/biggest-event.webp";
---

<!--
[ABOUT] BIGGEST EVENT
- Highlights the North Quincy branch's December 2024 donation drive, the largest single donation by any Unity Provisions branch to date.
-->
<Container as="section">
  <!--
    pt-8/md:pt-10 (was symmetric py-12/md:py-16) — trimmed since
    about.astro puts a Divider directly above this section; the old
    symmetric padding stacked with About_Heading's own bottom padding
    into unmarked white space. pb stays at the standard pb-12/md:pb-16
    — About_Stats still needs the usual gap flowing into it below.
  -->
  <div class="flex flex-col gap-6 pt-8 md:pt-10 pb-12 md:pb-16">
    <SectionHeading eyebrow="Recent Highlight" title="What One Branch Can Do" />

    <div class="flex flex-col gap-8 md:flex-row md:items-start">
      <div class="mx-auto w-full max-w-100 shrink-0 md:mx-0">
        <!--
          width/height read straight off bigEventPhoto's own real
          ImageMetadata, not a hardcoded 600x400 — same fix as
          About_Heading's founder photo (§7): ResponsiveImage generates
          from the real, full native resolution so the source stays
          sharp, while this wrapper's max-w-[400px] + Tailwind's
          default max-width:100%/height:auto (no class override needed
          here, same as About_Heading) handles the actual display size.

          loading="eager" — corrected by the project owner (was
          previously documented as lazy, ResponsiveImage's default).
        -->
        <ResponsiveImage
          src={bigEventPhoto}
          alt="North Quincy branch's December 2024 donation drive for the Quincy Community Action Program"
          width={bigEventPhoto.width}
          height={bigEventPhoto.height}
          radius="md"
          loading="eager"
        />
        <p class="mt-3 text-center text-sm text-text-secondary md:text-left">
          North Quincy branch · December 2024
        </p>
      </div>

      <div class="flex max-w-2xl flex-col gap-4 text-lg text-text-secondary">
        <p>
          On December 20, 2024, our North Quincy branch collected, sorted, and 
          donated 1,025 pounds of food to the Quincy Community Action Program. 
          It was the largest donation any Unity Provisions branch had made at the time.
        </p>
        <p>
          It's one example of what a group of students can accomplish when they come together, 
          and a glimpse of what becomes possible as more branches get involved.
        </p>
      </div>
    </div>
  </div>
</Container>