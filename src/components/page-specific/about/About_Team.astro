---
import Container from "@components/reusable/ui/Container.astro";
import SectionHeading from "@components/reusable/ui/SectionHeading.astro";
import Button from "@components/reusable/ui/Button.astro";
---

<!-- [ABOUT] TEAM
- Displays the team section with a heading, description, and a button linking to the team page.
-->
<Container as="section">
  <!--
    pt-8/md:pt-10 (was symmetric py-12/md:py-16) — trimmed since
    about.astro now puts a Divider directly above this section (§11:
    About_AnnualReport and this are both white at the seam). pb stays
    at the standard pb-12/md:pb-16 — Footer is sage right after, not
    another white section, so no divider/trim applies on that side.
  -->
  <div class="flex flex-col items-center gap-6 pt-8 pb-12 text-center md:pt-10 md:pb-16">
    <SectionHeading
      icon="lucide:users"
      title="Meet the People Behind It"
      subtext="A closer look at the students and mentors behind Unity Provisions."
      align="center"
    />
    <Button href="/team" variant="primary" size="md"> Meet the Team </Button>
  </div>
</Container>