---
import Container from "@components/reusable/ui/Container.astro";
import SectionHeading from "@components/reusable/ui/SectionHeading.astro";
import PartnersAndSupporters from "@components/reusable/sections/PartnersAndSupporters.astro";
import { partners } from "@data/partners";
---

<!-- [ABOUT] PARTNERS AND SUPPORTERS
- Partners and Supporters section for the About page.
- Displays the partners and supporters for Unity Provisions. (Lengthy version)
- Has heading and list of partners and supporters, with a brief description of each.
-->
<Container as="section">
  <div
    class="flex flex-col items-center gap-2 pt-8 pb-4 text-center md:pt-10 md:pb-6"
  >
    <SectionHeading
      title="Our Community of Support"
      subtext="The organizations and community groups that help our branches do their work."
      align="center"
    />
  </div>
</Container>

<PartnersAndSupporters
  partners={partners}
  partnersIntro="Our partners help provide space, guidance, and other support that allows donation centers to serve their communities. Wang YMCA of Chinatown and Mystic Valley YMCA host our program at their branches, helping make donation centers more accessible to the people who need them. We also work with student-led organizations like Food4Philly to extend that reach into more communities."
  supportersIntro="We're grateful for the generous support of organizations and institutions that believe in our mission to fight food insecurity. Their support helps us sustain our current programs, launch new initiatives, and open new branches."
/>