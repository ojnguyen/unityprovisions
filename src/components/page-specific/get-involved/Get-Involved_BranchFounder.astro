---
import Container from "@components/reusable/ui/Container.astro";
import SectionHeading from "@components/reusable/ui/SectionHeading.astro";
import ExternalLinkCTA from "@components/reusable/ui/ExternalLinkCTA.astro";
import { Icon } from "astro-icon/components";
import { getStatValue } from "@utils/stats";

// Pulled from stats.ts using getStatValue()
const branchCount = getStatValue("branches"); // "35+"
const countryCount = getStatValue("countries"); // "8+"

// Branch Founder support list (a list of support items for branch founders)
const branchFounderSupport = [
  "Help getting approval from your school or community",
  "Guidance for planning and running events",
  "Access to reimbursements through our YMCA partnership",
  "Ready-to-use promotional materials and planning tools",
  "Opportunities for funding to grow your ideas",
];
---

<!--
[GET-INVOLVED] BRANCH FOUNDER
- Branch Founder section for the Get Involved page, including the heading, checklist, paragraph with branch/country counts, and CTA.
-->
<Container as="section">
  <div class="flex flex-col items-center gap-8 py-12 text-center md:py-16">
    <SectionHeading
      eyebrow="Branch Founder"
      title="Build Something That Lasts"
      align="center"
    />

    <ul class="flex w-full max-w-2xl flex-col gap-3 text-left">
      {
        branchFounderSupport.map((item) => (
          <li class="flex items-start gap-3 text-lg text-text-secondary">
            <Icon
              name="lucide:check"
              aria-hidden="true"
              class="mt-1 h-5 w-5 shrink-0 text-primary"
            />
            <span>{item}</span>
          </li>
        ))
      }
    </ul>

    <p class="max-w-2xl text-lg text-text-secondary">
      As a Branch Founder, you'll start and lead a Unity Provisions branch in your school or community. 
      You'll have the support, resources, and mentorship to help turn your idea into a working local donation center. 
      You won't be building this alone. Every Branch Founder is paired with a mentor, and you'll join a growing network 
      of {branchCount} student-led branches across {countryCount} countries working to address food insecurity in their communities.
    </p>

    <ExternalLinkCTA
      label="Apply"
      href="https://forms.gle/qfwhsPP61RrAd1cW7"
      icon="lucide:arrow-up-right"
    />
  </div>
</Container>
