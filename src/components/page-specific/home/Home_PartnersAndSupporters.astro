---
import Container from "@components/reusable/ui/Container.astro";
import SectionHeading from "@components/reusable/ui/SectionHeading.astro";
import PartnersAndSupporters from "@components/reusable/sections/PartnersAndSupporters.astro";
import { partners } from "@data/partners";
---

<!-- [HOME] PARTNERS AND SUPPORTERS
- Heading for the Partners and Supporters section on the Home page, followed by a grid of partner and supporter logos.
-->
<Container as="section">
  <!-- Should it be flex flex-col items-center gap-2 pt-8 pb-4 text-center md:pt-10 md:pb-6? -->
  <div
    class="flex flex-col items-center gap-2 pt-12 pb-4 text-center md:pt-16 md:pb-6"
  >
    <SectionHeading title="Our Partners & Supporters" align="center" />
  </div>
</Container>

<PartnersAndSupporters partners={partners} />
