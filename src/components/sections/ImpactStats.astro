---
import Container from '@components/ui/Container.astro';
import type { Stat } from '@/types';

interface Props {
  stats: Stat[];
}

const { stats } = Astro.props as Props;

// Live source for the stats marked with `liveSheetLabel` in
// src/data/stats.ts: the "Donations Overview" tab of a public Google
// Sheet, read client-side via Google's own Visualization API (the same
// mechanism Sheets uses to power charts embedded on other sites),
// requested through a JSONP <script> tag rather than fetch() — Google's
// gviz endpoint doesn't send Access-Control-Allow-Origin, so a plain
// fetch() gets blocked by CORS; a <script> tag isn't subject to that
// restriction, which is exactly what JSONP exists for.
//
// The query sent to Google explicitly asks for "column B, column C,
// WHERE column B equals one of our expected labels" — this is safer
// than fetching a row range and filtering client-side, because it
// can't accidentally pick up unrelated tables/data living further down
// the same tab (this sheet has a donation log starting a few rows below
// the summary numbers, which is exactly what tripped up the first
// version of this component).
//
// A stat is only updated if it has `liveSheetLabel` set AND a row in
// the sheet has that exact text in column B — everything else (stats
// with no `liveSheetLabel`, or a label that isn't found) stays exactly
// as rendered from the `stats` prop below.
//
// Requirement on the sheet: sharing must be set to "Anyone with the
// link – Viewer" — see project-roadmap.md §10 for current status.
const SHEET_ID = '14C4v_A39CNRhI9oQ-i7GHagwggTS3jptgRGuu5UD6_w';
const SHEET_GID = '638911803'; // the "Donations Overview" tab

const TEST_SHEET_ID = '1C3PwvkF2R8WcGingK4tUvuFeBT5ZfNOsvNDsdm3K3vQ';
const TEST_SHEET_GID = '638911803'; // the "Donations Overview" tab

// IMPORTANT: scoped to just the summary block (title row + 5 stat rows).
// The tab also has an unrelated donation log starting immediately at
// row 7, with no buffer row in between. Google's query engine infers
// each column's type from the MAJORITY of values it considers — if this
// range were widened to include the log, column B would be mostly
// dates, and the whole column (including the "Total (lbs)" / "Money
// Collected ($)" text cells) would silently be treated as non-string,
// causing the WHERE match below to find nothing with no error at all.
// If rows are added/removed from the summary block, update this range.
const SHEET_RANGE = 'B1:C6';

// LIVE_LABELS is Total (lbs) and Money Collected ($)
const LIVE_LABELS = stats
  .map((stat) => stat.liveSheetLabel)
  .filter((label): label is string => typeof label === 'string' && label.length > 0);
---
<Container as="section">
  <dl class="grid grid-cols-2 gap-8 py-8 text-center md:grid-cols-4 md:py-12">
    {stats.map((stat) => (
      <div class="flex flex-col items-center gap-1" data-live-label={stat.liveSheetLabel}>
        <dt class="text-3xl font-bold text-primary">{stat.value}</dt>
        <dd class="text-sm text-text-secondary">{stat.label}</dd>
      </div>
    ))}
  </dl>
</Container>

<script define:vars={{ SHEET_ID, SHEET_GID, SHEET_RANGE, LIVE_LABELS }}>
  
  // liveEls is a NodeList of all the <div> elements in the stat grid that have a `data-live-label` attribute.
  // Each of those elements corresponds to a stat that should be updated with live data from the Google Sheet.
  // If there are no such elements, or if LIVE_LABELS is empty, we don't need to do anything.
  const liveEls = document.querySelectorAll('[data-live-label]');

  if (liveEls.length > 0 && LIVE_LABELS.length > 0) {
    loadLiveStats();
  }

  // Loads a Google Sheets gviz URL via JSONP (a <script> tag, not fetch),
  // since gviz doesn't support cross-origin fetch()/XHR requests.
  function fetchGvizJsonp(url) {
    return new Promise((resolve, reject) => {
      const callbackName = '__unityImpactStatsCallback';

      function cleanup() {
        delete window[callbackName];
        script.remove();
      }

      window[callbackName] = (response) => {
        cleanup();
        resolve(response);
      };

      const script = document.createElement('script');
      script.src = url;
      script.onerror = () => {
        cleanup();
        reject(new Error('Failed to load the sheet.'));
      };
      document.head.append(script);
    });
  }

  // Escapes a string for safe use inside a single-quoted Google
  // Visualization Query Language literal.
  function escapeForQuery(str) {
    return str.replace(/\\/g, '\\\\').replace(/'/g, "\\'");
  }

  // Normalizes a string for comparison: trims whitespace, collapses
  // internal whitespace, and lowercases. Used to match sheet labels.
  function normalize(str) {
    return String(str ?? '')
      .replace(/\s+/g, ' ')
      .trim()
      .toLowerCase();
  }

  // Loads live stats from the Google Sheet and updates the DOM elements with the corresponding data.
  async function loadLiveStats() {
    // Equivalent SQL Query: SELECT B, C WHERE B = 'Total (lbs)' OR B = 'Money Collected ($)'
    const whereClause = LIVE_LABELS.map((label) => `B = '${escapeForQuery(label)}'`).join(' OR ');
    const query = `SELECT B, C WHERE ${whereClause}`;

    // The URL for the Google Sheets gviz endpoint, with the query and range parameters.
    // Source: https://developers.google.com/chart/interactive/docs/querylanguage#sending-queries-to-the-server
    const url =
      `https://docs.google.com/spreadsheets/d/${SHEET_ID}/gviz/tq` + // The base URL for the Google Sheets gviz endpoint, with the sheet ID.
      `?gid=${SHEET_GID}` + // The GID of the sheet tab to query.
      `&range=${encodeURIComponent(SHEET_RANGE)}` + // The range of cells to query.
      `&tq=${encodeURIComponent(query)}` + // The query string, URL-encoded.
      `&tqx=out:json;responseHandler:__unityImpactStatsCallback`; // The output format and callback function name.

    try {
      const response = await fetchGvizJsonp(url);
      // console.log('ImpactStats: live sheet response', response);

      if (response.status === 'error') {
        throw new Error(
          `Sheet query failed: ${JSON.stringify(response.errors)}. Query used: ${query}`
        );
      }

      // Build a normalized-label -> formatted value lookup from the
      // (small, pre-filtered) set of rows Google's query returned.
      const sheetValues = new Map(); // Map where the key is the normalized label from column B, and the value is the corresponding value from column C.
      for (const row of response.table.rows) {
        const labelCell = row.c && row.c[0]; // The first cell in the response row, which contains the label (column B). NOTE: Google's gviz API returns the columns in the order they were requested in the query, so column B is the first cell in the row.
        const valueCell = row.c && row.c[1]; // The second cell in the response row, which contains the value (column C).
        const rawLabel = String((labelCell && (labelCell.f ?? labelCell.v)) ?? '').trim(); // Label -- preferably formatted but falls back to raw value
        const value = String((valueCell && (valueCell.f ?? valueCell.v)) ?? '').trim(); // Value -- preferably formatted but falls back to raw value
        if (rawLabel) sheetValues.set(normalize(rawLabel), value);  // Store the normalized label and its corresponding value in the map.
      }

      // Replace the text content of each live stat element with the corresponding value from the sheet, if found.
      liveEls.forEach((el) => {
        const key = el.dataset.liveLabel; // The normalized label for this stat, as specified in the `data-live-label` attribute. e.g. "Total (lbs)" or "Money Collected ($)"
        const liveValue = sheetValues.get(normalize(key)); // The value from the sheet corresponding to this normalized label, if found.
        if (liveValue) {
          const dt = el.querySelector('dt'); // The <dt> element inside this stat element, which contains the value to be updated.
          if (dt) dt.textContent = liveValue; // Update the text content of the <dt> element with the live value from the sheet.
        } else {
          console.warn(
            `ImpactStats: Not a valid liveValue OR no sheet row matched liveSheetLabel "${key}". ` +
            `Query used: ${query} — labels found: ${JSON.stringify([...sheetValues.keys()])}`
          );
        }
      });
    } catch (error) {
      // Sheet unreachable, not yet public, or an unexpected shape — the
      // build-time fallback values rendered above stay untouched.
      console.error('ImpactStats: could not load live stats.', error);
    }
  }
</script>