---
import Container from '@components/ui/Container.astro';
import SectionHeading from '@components/ui/SectionHeading.astro';
import Button from '@components/ui/Button.astro';
import { Icon } from 'astro-icon/components';

interface Props {
  heading: string;
  subtext: string;
  ctaLabel: string;
  icon?: string;
}

const { heading, subtext, ctaLabel, icon } = Astro.props as Props;
---
<Container as="section">
  <div class="flex flex-col items-center gap-6 py-12 text-center md:py-16">
    {icon && (
      <span class="flex h-12 w-12 items-center justify-center rounded-full bg-primary/10 text-primary">
        <Icon name={icon} aria-hidden="true" class="h-6 w-6" />
      </span>
    )}
    <SectionHeading title={heading} subtext={subtext} align="center" />
    <Button href="/get-involved" variant="primary" size="md">
      {ctaLabel}
    </Button>
  </div>
</Container>