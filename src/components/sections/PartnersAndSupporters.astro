---
import Container from '@components/ui/Container.astro';
import Card from '@components/ui/Card.astro';
import { Icon } from 'astro-icon/components';
import type { ImageMetadata } from 'astro';
import type { Partner } from '@/types';

interface Props {
  partners: Partner[];
  /**
   * Optional framing paragraph shown under each group's heading.
   * Supplying either prop switches that group from Home's compact
   * badge row into a fuller, more detailed card-grid treatment (used
   * by About) — presence of real intro copy is the signal, rather
   * than a separate boolean flag.
   */
  partnersIntro?: string;
  supportersIntro?: string;
}

const { partners, partnersIntro, supportersIntro } = Astro.props as Props;

// An entry with no `type` set is treated as a partner by default.
const partnerOrgs = partners.filter((org) => org.type !== 'supporter');
const supporterOrgs = partners.filter((org) => org.type === 'supporter');

// Grouped into one array so the markup below only needs to loop once,
// instead of repeating the same badge/logo rendering twice. A group is
// skipped entirely if the page passed in zero orgs of that type (e.g.
// a "brief" Home version that only supplies partners).
const groups = [
  { label: 'Partners', orgs: partnerOrgs, intro: partnersIntro },
  { label: 'Supporters', orgs: supporterOrgs, intro: supportersIntro },
].filter((group) => group.orgs.length > 0);

// Partner.logo can be a local `src/assets/...` import (ImageMetadata,
// processed by Vite) or a plain string URL/path — both need to end up
// as a plain src string for the <img> tags below. Kept as plain <img>
// (not ResponsiveImage/astro:assets <Image>) since real logo aspect
// ratios vary per organization and guessing a fixed width/height for
// the optimizer risks distorting one.
function resolveLogoSrc(logo: ImageMetadata | string): string {
  return typeof logo === 'string' ? logo : logo.src;
}
---
<div class="border-y border-border bg-surface">
  <Container as="section">
    <div class="flex flex-col gap-10 py-12 md:py-16">
      {groups.map((group) => (
        <div class="flex flex-col items-center gap-4 text-center">
          <h3 class="text-sm font-semibold uppercase tracking-wide text-primary">
            {group.label}
          </h3>

          {group.intro && (
            <p class="max-w-2xl text-base text-text-secondary">
              {group.intro}
            </p>
          )}

          {group.intro ? (
            <div class="grid w-full grid-cols-2 gap-4 sm:grid-cols-3 md:grid-cols-4">
              {group.orgs.map((org) => (
                <Card padding="md" bg="bg">
                  <div class="flex flex-col items-center gap-2 text-center">
                    {org.logo ? (
                      <img src={resolveLogoSrc(org.logo)} alt={org.name} class="h-12 object-contain" />
                    ) : (
                      <Icon name="lucide:building-2" aria-hidden="true" class="h-8 w-8 text-primary/60" />
                    )}
                    <span class="text-sm font-medium text-text-primary">{org.name}</span>
                  </div>
                </Card>
              ))}
            </div>
          ) : (
            <div class="flex flex-wrap items-center justify-center gap-3">
              {group.orgs.map((org) => (
                org.logo ? (
                  <img src={resolveLogoSrc(org.logo)} alt={org.name} class="h-10 object-contain" />
                ) : (
                  <span class="inline-flex items-center gap-1.5 rounded-sm border border-border px-3 py-1.5 text-sm text-text-secondary">
                    <Icon name="lucide:building-2" aria-hidden="true" class="h-3.5 w-3.5 text-primary/60" />
                    {org.name}
                  </span>
                )
              ))}
            </div>
          )}
        </div>
      ))}
    </div>
  </Container>
</div>