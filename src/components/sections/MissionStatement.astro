---
import Container from '@components/ui/Container.astro';
import SectionHeading from '@components/ui/SectionHeading.astro';
import { Icon } from 'astro-icon/components';

interface Props {
  heading: string;
  body: string;
  icon?: string;
}

const { heading, body, icon } = Astro.props as Props;
---
<Container as="section">
  <div class="flex flex-col items-center gap-6 py-12 text-center md:py-16">
    {icon && (
      <span class="flex h-12 w-12 items-center justify-center rounded-full bg-primary/10 text-primary">
        <Icon name={icon} aria-hidden="true" class="h-6 w-6" />
      </span>
    )}
    <SectionHeading title={heading} align="center" />
    <p class="max-w-3xl text-lg text-text-secondary">
      {body}
    </p>
  </div>
</Container>