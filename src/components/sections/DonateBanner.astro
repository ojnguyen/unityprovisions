---
import Container from '@components/ui/Container.astro';
import Button from '@components/ui/Button.astro';

interface Props {
  heading: string;
  subtext: string;
  ctaLabel: string;
}

// All required, no defaults — matches GetInvolvedTeaser's exact prop
// shape, this component's closest sibling: both are closing-teaser
// bands (heading + subtext + one CTA button) whose destination is
// hardcoded inside the component, not exposed as a prop, so it can't be
// misused to point somewhere else.
const { heading, subtext, ctaLabel } = Astro.props as Props;
---
<div class="bg-primary-hover">
  <Container as="section">
    <div class="flex flex-col items-center gap-6 py-16 text-center md:py-20">
      <h2 class="max-w-2xl text-2xl font-bold text-white">
        {heading}
      </h2>
      <p class="max-w-2xl text-lg text-white/80">
        {subtext}
      </p>
      <Button href="/donate" variant="accent" size="lg">
        {ctaLabel}
      </Button>
    </div>
  </Container>
</div>